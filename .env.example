# MyHumanRep environment reference. Placeholders only. Never commit real values.
#
# Where each value lives:
#   [var]    non-secret Worker variable: wrangler.jsonc "vars" (per environment)
#   [secret] Worker secret: `npx wrangler secret put NAME --env <staging|production>`;
#            locally in an untracked .dev.vars file (see .dev.vars.example)
#   [script] only read by scripts/*.ts on your machine

# ---------- Core ----------
ENVIRONMENT=development                 # [var] development | staging | production. Unknown values are treated as production.
PUBLIC_BASE_URL=http://localhost:8787   # [var] canonical origin. All public links, OpenAPI servers and MCP origin checks use it.
ALIAS_HOSTS=                            # [var] comma-separated hosts that 301 to PUBLIC_BASE_URL, e.g. myhumanrep.ca,www.myhumanrep.ca
DEFAULT_RETENTION_DAYS=30               # [var] default conversation lifetime; owner can override in /admin/settings
INTAKE_ENABLED=false                    # [var] default for accepting new inquiries; owner toggles in /admin/settings
HSTS_ENABLED=false                      # [var] set true only after TLS on the custom domain is verified
PUBLIC_CONTACT_EMAIL=                   # [var] optional human contact address shown on /privacy

# ---------- Conversation credentials ----------
CONVERSATION_TOKEN_HMAC_KEY=replace-with-at-least-32-random-characters   # [secret] required; the Worker returns 503 without it
CONVERSATION_TOKEN_HMAC_KEY_PREVIOUS=                                    # [secret] optional, only during key rotation

# ---------- Admin authentication ----------
ADMIN_AUTH_MODE=access                  # [var] access (staging/production) | dev_insecure (development on localhost only)
ACCESS_TEAM_DOMAIN=https://YOUR_TEAM.cloudflareaccess.com   # [var] Cloudflare Zero Trust team domain
ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD_TAG                  # [var] Access application audience tag
ADMIN_EMAILS=owner@example.com          # [var] comma-separated allowlist checked after JWT verification

# ---------- MCP ----------
MCP_ALLOWED_ORIGINS=                    # [var] extra browser origins allowed to call /mcp (PUBLIC_BASE_URL is always allowed)

# ---------- Owner notifications ----------
NOTIFY_PROVIDER=none                    # [var] none | log | resend | cloudflare_email
NOTIFY_TO=                              # [var] owner address that receives alerts
NOTIFY_FROM=                            # [var] verified sender address
RESEND_API_KEY=                         # [secret] only if NOTIFY_PROVIDER=resend
# cloudflare_email additionally needs a "send_email" binding named SEND_EMAIL in wrangler.jsonc.

# ---------- Optional limit overrides (defaults in src/worker/config.ts) ----------
LIMIT_FIRST_CONTACT_PER_SOURCE_PER_HOUR=10       # [var] also editable in /admin/settings
LIMIT_FIRST_CONTACT_GLOBAL_PER_DAY=500           # [var] also editable in /admin/settings
LIMIT_THREAD_OPS_PER_MINUTE=30                   # [var]
LIMIT_MCP_PER_SOURCE_PER_MINUTE=60               # [var]
LIMIT_AUTH_FAILURES_PER_SOURCE_PER_10_MIN=20     # [var]
LIMIT_MAX_AGENT_MESSAGES=50                      # [var]
LIMIT_MAX_REQUESTS_TOTAL=30                      # [var]
LIMIT_MAX_REQUESTS_ACTIVE=10                     # [var]

# ---------- Scripts ----------
BASE_URL=http://localhost:8787          # [script] target for smoke-rest.ts, smoke-mcp.ts, verify-openapi.ts
SHOW_TOKEN=0                            # [script] 1 prints the conversation token in smoke-rest.ts output
